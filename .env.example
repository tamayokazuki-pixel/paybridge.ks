# Copy to .env.local for local development:  cp .env.example .env.local
# Get these values from Supabase -> Project Settings -> API.
#
# On Vercel, do NOT rely on this file: add the same three variables in
# Project Settings -> Environment Variables (Production, and Preview if
# you use preview deployments), then redeploy. NEXT_PUBLIC_* values are
# inlined into the browser bundle at build time, so a change only takes
# effect in a NEW build.

# Project URL (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon public key (safe to expose; access is limited by row-level security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — SERVER ONLY. Never rename with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
